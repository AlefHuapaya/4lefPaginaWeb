# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# datos fuente de importación (contienen info de contratas/acuerdos/costos, no van al repo público)
/nuevos archivos/

# fondos originales sin procesar (nombres de archivo temporales); las versiones
# curadas y renombradas viven en /public/fondos y sí se versionan
/fondos para la pagina/
